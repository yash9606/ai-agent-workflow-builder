# =============================================================================
# Copy to .env.local for local development. Never commit real production secrets.
#
# PUBLIC       = browser-visible (NEXT_PUBLIC_* only)
# SERVER-ONLY  = server/runtime secrets — never prefix with NEXT_PUBLIC_
# =============================================================================

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# SERVER-ONLY — demo | nhost  (production: set nhost; Vercel+Nhost also forces nhost)
AUTH_MODE=demo
# SERVER-ONLY
DEMO_AUTH_PASSWORD=change-me-demo-password
# SERVER-ONLY (optional)
# ALLOW_DEMO_AUTH=true
# FORCE_NHOST_AUTH=true
# FORCE_PRODUCTION_ENV=true
# ALLOW_LOCAL_ENV_DEFAULTS=true

# PUBLIC — required for AUTH_MODE=nhost / Vercel production
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=
# SERVER-ONLY (optional RS256 JWKS)
# NHOST_JWT_JWKS_URL=https://<subdomain>.auth.<region>.nhost.run/v1/jwks

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SERVER-ONLY — local placeholder; production = Nhost Postgres URL (not localhost)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# -----------------------------------------------------------------------------
# Hasura GraphQL HTTP + WebSocket (can be set independently)
# -----------------------------------------------------------------------------
# PUBLIC — GraphQL HTTP endpoint used by the browser
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
# PUBLIC — optional explicit subscriptions endpoint.
# If unset, derived from NEXT_PUBLIC_HASURA_GRAPHQL_URL (https→wss, http→ws).
# Production must be wss://… (or https://… which the client upgrades to wss://).
# NEXT_PUBLIC_HASURA_WS_URL=wss://<hasura-or-nhost-host>/v1/graphql
# SERVER-ONLY — optional server-side HTTP override
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
# SERVER-ONLY — never expose to the browser
HASURA_ADMIN_SECRET=change-me-hasura-admin-secret
# SERVER-ONLY — must match Hasura/Nhost JWT config
HASURA_JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Hasura → Next.js Actions / events / cron
# -----------------------------------------------------------------------------
# SERVER-ONLY — Hasura container → Next.js (local Docker uses host.docker.internal)
ACTION_BASE_URL=http://host.docker.internal:3000
# SERVER-ONLY
ACTION_SHARED_SECRET=change-me-action-shared-secret
# SERVER-ONLY
HASURA_EVENT_SECRET=change-me-event-secret
# SERVER-ONLY
CRON_SECRET=change-me-cron-secret

# -----------------------------------------------------------------------------
# Webhooks / notify / LLM
# -----------------------------------------------------------------------------
# SERVER-ONLY — local demo seed reference only; rotate outside demos
WEBHOOK_HMAC_SECRET=change-me-webhook-secret
# SERVER-ONLY
NOTIFY_WEBHOOK_URL=
# SERVER-ONLY — leave empty for stub LLM
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
# PUBLIC — production must be https:// your Vercel (or custom) domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
